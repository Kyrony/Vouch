crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":4194326,"unicode":0,"echo":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="interactables"
3d_physics/layer_3="players"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_environment="res://assets/materials/default_environment.tres"
