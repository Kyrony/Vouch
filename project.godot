; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vouch"
config/description="Horror neighborhood chase — find the missing child, escape the Puppet Master."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/brand/vouch_icon_128.png"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
MatchClock="*res://scripts/autoload/match_clock.gd"
FactionData="*res://scripts/autoload/faction_data.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
ContactBook="*res://scripts/autoload/contact_book.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
MatchSettings="*res://scripts/autoload/match_settings.gd"
EscapePathSettings="*res://scripts/autoload/escape_path_settings.gd"
HorrorModeSettings="*res://scripts/autoload/horror_mode_settings.gd"
PlayerHealth="*res://scripts/horror/player_health.gd"
PlayerInventory="*res://scripts/horror/player_inventory.gd"
PlayerEffects="*res://scripts/horror/items/player_effects.gd"
PhoneDevice="*res://scripts/horror/items/phone_device.gd"
ChildSpawnRNG="*res://scripts/horror/world/child_spawn_rng.gd"
TowerRules="*res://scripts/horror/world/tower_rules.gd"
LinkGraph="*res://scripts/systems/link_graph.gd"
PhoneSystem="*res://scripts/systems/phone_system.gd"
EscapeSystem="*res://scripts/systems/escape_system.gd"
PuzzleSystem="*res://scripts/systems/puzzle_system.gd"
PuppetMasterSystem="*res://scripts/systems/puppet_master_system.gd"
PuppetStringSystem="*res://scripts/systems/puppet_string_system.gd"
PuppetControlSystem="*res://scripts/systems/puppet_control_system.gd"
RoomUtilities="*res://scripts/autoload/room_utilities.gd"
FireSystem="*res://scripts/systems/fire_system.gd"
WalkieSystem="*res://scripts/systems/walkie_system.gd"
WorldScale="*res://scripts/world_scale.gd"
DebugBuild="*res://scripts/autoload/debug_build.gd"
DebugCheats="*res://scripts/debug/debug_cheats.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

