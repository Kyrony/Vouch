; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vouch"
config/description="Industrial bunker social-deduction party game. Trust no one. First faction to fully escape wins."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/brand/vouch_icon_128.png"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
FactionData="*res://scripts/autoload/faction_data.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
ContactBook="*res://scripts/autoload/contact_book.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
MatchSettings="*res://scripts/autoload/match_settings.gd"
LinkGraph="*res://scripts/systems/link_graph.gd"
PhoneSystem="*res://scripts/systems/phone_system.gd"
EscapeSystem="*res://scripts/systems/escape_system.gd"
PuzzleSystem="*res://scripts/systems/puzzle_system.gd"
PuppetMasterSystem="*res://scripts/systems/puppet_master_system.gd"
RoomUtilities="*res://scripts/autoload/room_utilities.gd"
FireSystem="*res://scripts/systems/fire_system.gd"
WalkieSystem="*res://scripts/systems/walkie_system.gd"
WorldScale="*res://scripts/world_scale.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":87,"unicode":119,"echo":false,"script":null)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":83,"unicode":115,"echo":false,"script":null)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":65,"unicode":97,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":68,"unicode":100,"echo":false,"script":null)
]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":32,"unicode":32,"echo":false,"script":null)
]
}
interact={
